# Copy to .env and fill in real values (never commit .env)

# Secret key for Django (generate: python -c "import secrets; print(secrets.token_urlsafe(64))")
DJANGO_SECRET_KEY=change-me

# Never enable DEBUG on a public server
DJANGO_DEBUG=false

# Comma separated
DJANGO_ALLOWED_HOSTS=cardverse.example.com,www.cardverse.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://cardverse.example.com,https://www.cardverse.example.com

# HTTPS behind a proxy (nginx, load balancer)
DJANGO_SECURE_COOKIES=true
DJANGO_SSL_REDIRECT=true

# Optional: custom sqlite path (use a persistent disk on PaaS)
# DJANGO_DB_PATH=/var/lib/cardverse/db.sqlite3